# ---- Supabase database ----
# Supabase dashboard -> Project -> Connect -> "Session pooler" connection string (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# ---- Auth ----
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# ---- Behaviour ----
# Timezone used for "today", opening hours and appointment slots.
APP_TIMEZONE=Asia/Karachi
# true = walk-in tokens only during a department's working hours (false is handy for demos at any time of day)
ENFORCE_WORKING_HOURS=false
# A called customer skipped this many times is marked as a no-show
MAX_SKIPS=3
# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGINS=*
DB_POOL_SIZE=5
